# Production API base URL, baked in at build time by Vite.
#
# Committed deliberately so a production build is correct without anyone having
# to remember a Vercel dashboard setting. This is not a secret — it ends up in
# the client bundle regardless.
#
# A VITE_AUTH_ENDPOINT set in the Vercel dashboard still wins: Vite does not
# override variables already present in the build environment.
VITE_AUTH_ENDPOINT=https://so-4692446bcade4703a9fb30dc02fba183.ecs.eu-west-1.on.aws
