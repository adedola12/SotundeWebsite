# Base URL of the Sotunde Website API (no trailing slash).
#
# Local dev:
#   VITE_AUTH_ENDPOINT=http://localhost:4000
#
# Production (AWS App Runner, eu-west-1) — the deploy script prints this URL:
#   VITE_AUTH_ENDPOINT=https://<id>.eu-west-1.awsapprunner.com
#
# Must also be set in the Vercel dashboard for both sotunde-website and
# sotunde-website-cpqb, then redeploy.
VITE_AUTH_ENDPOINT=http://localhost:4000
